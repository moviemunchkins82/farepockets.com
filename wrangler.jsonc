// Cloudflare Workers deployment (via @opennextjs/cloudflare). A separate Worker
// named "farepockets"; it doesn't touch any other site on the account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farepockets",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "farepockets"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Runtime settings. Kept here because `wrangler deploy` replaces plain
  // variables set in the dashboard. None are secret; the Worker needs no secrets.
  "vars": {
    "TRAVELPAYOUTS_MARKER": "783427",
    "TRAVELPAYOUTS_WIDGET_SRC_TEMPLATE": "https://tpwgts.com/content?currency=usd&trs=579321&shmarker={marker}.{subId}&show_hotels=false&powered_by=true&locale=en&searchUrl=www.aviasales.com%2Fsearch&primary_override=%23cc4747&color_button=%23cc4747&color_icons=%23cc4747&dark=%23111827&light=%23FFFFFF&secondary=%23FFFFFF&special=%23E0E5EB&color_focused=%23cc4747&border_radius=8&plain=true&promo_id=7879&campaign_id=100",
    "TRAVELPAYOUTS_DEEPLINK_TEMPLATE": "https://tp.media/r?campaign_id=100&marker={marker}&p=4114&sub_id={subId}&trs=579321&u=https%3A%2F%2Fwww.aviasales.com%2Fsearch%2F{origin}{date}{destination}1"
  }
}
