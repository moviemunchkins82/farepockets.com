# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://farepockets.com
NEXT_PUBLIC_SITE_NAME=FarePockets
# Keep false until launch: pages carry noindex and robots.txt disallows crawling.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Travelpayouts ---
# API token: Travelpayouts dashboard > Profile > API token. Only the price refresh
# (npm run refresh:prices) uses it; the site itself doesn't.
TRAVELPAYOUTS_TOKEN=
# Your partner marker (numeric ID shown in the dashboard)
TRAVELPAYOUTS_MARKER=
# Paste the exact values the dashboard gives you, then replace your marker with {marker}
# and add {subId} for per-page attribution (Travelpayouts sub IDs are usually appended
# to the marker after a dot: {marker}.{subId}). Confirm the format in your dashboard.
#   Widget: the src="" of the Aviasales search form <script> (Tools > Widgets), with
#           shmarker=YOUR_MARKER changed to shmarker={marker}.{subId}. The value below also sets
#           the site's colors (#cc4747 coral, #111827 text), 8px corners, plain=true (no Aviasales header) and
#           show_hotels=false. PROJECT_ID is your trs= value.
#   Deep link: the full (not short) link from Tools > Links, which goes through Travelpayouts'
#           tp.media/r redirect so clicks and sub IDs show in the dashboard. Replace the encoded
#           u= target with Aviasales search results: {date} is the departure day as DDMM (the
#           route's cheapest cached date, or 30 days out). PROJECT_ID is the trs= value.
TRAVELPAYOUTS_WIDGET_SRC_TEMPLATE=https://tpwgts.com/content?currency=usd&trs=PROJECT_ID&shmarker={marker}.{subId}&show_hotels=false&powered_by=true&locale=en&searchUrl=www.aviasales.com%2Fsearch&primary_override=%23cc4747&color_button=%23cc4747&color_icons=%23cc4747&dark=%23111827&light=%23FFFFFF&secondary=%23FFFFFF&special=%23E0E5EB&color_focused=%23cc4747&border_radius=8&plain=true&promo_id=7879&campaign_id=100
TRAVELPAYOUTS_DEEPLINK_TEMPLATE=https://tp.media/r?campaign_id=100&marker={marker}&p=4114&sub_id={subId}&trs=PROJECT_ID&u=https%3A%2F%2Fwww.aviasales.com%2Fsearch%2F{origin}{date}{destination}1

# --- Analytics (optional, only load when NEXT_PUBLIC_ALLOW_INDEXING=true) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
