# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://farepockets.com
NEXT_PUBLIC_SITE_NAME=FarePockets
# Keep false until launch. Flip to true in the same deploy that blanks BASIC_AUTH_*.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Database (Supabase Postgres) ---
# Use the Supavisor pooler string (Project Settings > Database > Connection string).
# Supabase's direct host is IPv6-only, which many hosts (including shared Node hosting) can't reach.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Travelpayouts ---
# API token: Travelpayouts dashboard > Profile > API token
TRAVELPAYOUTS_TOKEN=
# Your partner marker (numeric ID shown in the dashboard)
TRAVELPAYOUTS_MARKER=
# Paste the exact values the dashboard gives you, then replace your marker with {marker}
# and add {subId} for per-page attribution (Travelpayouts sub IDs are usually appended
# to the marker after a dot: {marker}.{subId}). Confirm the format in your dashboard.
#   Widget: the src="" of the Aviasales search form <script> (Tools > Widgets), with
#           shmarker=YOUR_MARKER changed to shmarker={marker}.{subId}, e.g.
#           https://tpwgts.com/content?currency=usd&trs=PROJECT_ID&shmarker={marker}.{subId}&...&promo_id=7879&campaign_id=100
#   Deep link: the full (not short) link from Tools > Links, which goes through Travelpayouts'
#           tp.media/r redirect so clicks and sub IDs show in the dashboard. Replace the encoded
#           u= target with Aviasales search results: {date} is the departure day as DDMM (the
#           route's cheapest cached date, or 30 days out). PROJECT_ID is the trs= value.
TRAVELPAYOUTS_WIDGET_SRC_TEMPLATE=
TRAVELPAYOUTS_DEEPLINK_TEMPLATE=https://tp.media/r?campaign_id=100&marker={marker}&p=4114&sub_id={subId}&trs=PROJECT_ID&u=https%3A%2F%2Fwww.aviasales.com%2Fsearch%2F{origin}{date}{destination}1

# --- Cron / admin ---
# Long random string, e.g. `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
CRON_SECRET=
# Where scripts/refresh-prices.ts sends its revalidate request. Defaults to NEXT_PUBLIC_SITE_URL;
# set to the local app (e.g. http://127.0.0.1:3000) when the cron runs on the same server.
REVALIDATE_BASE_URL=

# --- Pre-launch access gate (HTTP Basic Auth). Blank both at launch. ---
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# --- Analytics (optional, only load when NEXT_PUBLIC_ALLOW_INDEXING=true) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
